{
  "name": "mgym",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:html:all": "npm run build:html:carousel && npm run build:html:sentier",
    "build:html:carousel": "npm run export:carousel && node build-standalone.js --variant=carousel",
    "build:html:sentier": "npm run export:sentier && node build-standalone.js --variant=sentier",
    "dev": "next dev",
    "export:carousel": "MGYM_VARIANT=carousel node scripts/export-statique.mjs",
    "export:sentier": "MGYM_VARIANT=sentier node scripts/export-statique.mjs",
    "formulaires": "node scripts/analyser-formulaires.mjs",
    "groq:check": "node scripts/valider-requetes.mjs",
    "livraison": "npm run livraison:carousel && npm run livraison:sentier",
    "livraison:carousel": "npm run export:carousel && node build-standalone.js --variant=carousel --dossier",
    "livraison:sentier": "npm run export:sentier && node build-standalone.js --variant=sentier --dossier",
    "migrer": "node scripts/migrer.mjs",
    "migrer:ecrire": "node scripts/migrer.mjs --ecrire",
    "prebuild": "node scripts/vider-cache-donnees.mjs",
    "schemas:check": "node scripts/valider-schemas.mjs",
    "start": "next start",
    "start:horsligne": "node serve.js",
    "studio:build": "sanity build studio -y",
    "studio:deploy": "sanity deploy",
    "studio:dev": "sanity dev --port 3333",
    "test": "node --test \"lib/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "verifier": "npm run schemas:check && npm run groq:check && npm test && npm run build",
    "verifier:historique": "node scripts/verifier-historique.mjs",
    "verifier:workflow": "node scripts/tester-workflow.mjs"
  },
  "dependencies": {
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/locale-fr-fr": "^1.2.36",
    "@sanity/vision": "^4.22.1",
    "next": "^15.5.23",
    "next-sanity": "^11.6.13",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sanity": "^4.22.1",
    "styled-components": "^6.5.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.0",
    "adm-zip": "^0.6.0",
    "@sanity/uuid": "^3.0.3"
  }
}
