# .env.example — la LISTE des variables attendues, sans aucune valeur.
# Ce fichier est versionné ; le vrai fichier .env.local ne l'est jamais.
#
# Pour démarrer : copier ce fichier en .env.local et remplir les valeurs.
#   cp .env.example .env.local

# ── Identifiants publics du projet Sanity ───────────────────────
# Ces trois valeurs ne sont PAS des secrets : elles figurent dans l'URL
# de l'API et sont visibles par n'importe quel visiteur. Le préfixe
# NEXT_PUBLIC_ est donc volontaire et sans danger.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Les deux mêmes valeurs, en double, pour le Studio.
# Ce n'est pas une étourderie : Next et le CLI Sanity sont deux chaînes
# d'outillage distinctes, et chacune n'injecte dans son bundle que les
# variables portant SON préfixe. Next lit NEXT_PUBLIC_*, le Studio lit
# SANITY_STUDIO_*. Recopier la même valeur est le prix de la séparation.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Date figée : elle verrouille le comportement de l'API. Ne la changer
# qu'en connaissance de cause, jamais « pour être à jour ».
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ── Secrets — JAMAIS de préfixe NEXT_PUBLIC_ ────────────────────
# Sans préfixe, Next garde ces valeurs côté serveur : elles n'entrent
# jamais dans le bundle envoyé au navigateur.

# Token de LECTURE seule, utilisé uniquement par le mode prévisualisation
# pour lire les brouillons. Droits requis : « Viewer ».
SANITY_API_READ_TOKEN=

# Phrase secrète qui protège l'entrée du mode prévisualisation.
# Générer une valeur longue et aléatoire :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SANITY_PREVIEW_SECRET=

# ── Token d'ÉCRITURE — usage local exclusivement ────────────────
# Sert au seul script de migration (scripts/migrate.js), lancé à la main
# depuis un poste de développement. Il ne doit JAMAIS être configuré sur
# l'hébergeur : le site n'écrit jamais dans Sanity.
# Droits requis : « Editor ».
SANITY_API_WRITE_TOKEN=
